# Backtrack summary proxy configuration. No secrets are committed:
# copy to backend/.env (gitignored) and fill in real values locally.
# Verify endpoint/auth/model access with a minimal server-side request
# before integrating (verify-before-integrate).

# Initial integration target; do not assume other providers share it.
AI_PROVIDER=baseten
# Verified provider chat-completions base URL, e.g. https://inference.baseten.co/v1
AI_BASE_URL=
AI_MODEL=meta-models/muse-spark-open-1026
AI_API_KEY=
# Exact development extension origin for CORS, e.g. chrome-extension://<dev-extension-id>
ALLOWED_EXTENSION_ORIGIN=
