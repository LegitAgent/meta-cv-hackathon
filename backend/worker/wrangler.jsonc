{
  "routes": [
    {
      "pattern": "backtrack.martinalba.dev",
      "custom_domain": true
    }
  ],
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backtrack-api",
  "main": "src/entry.ts",
  "compatibility_date": "2026-11-01",
  "preview_urls": false,
  "workers_dev": false,
  "vars": {
    "GOOGLE_CLIENT_ID": "485394566822-r69tpao69h53eni3ddqb6cm1ao0qfgnl.apps.googleusercontent.com",
    "AI_BASE_URL": "https://api.meta.ai/v1",
    "AI_MODEL": "muse-spark-1.3",
    "ALLOWED_EXTENSION_ORIGINS": "chrome-extension://icmegjccphakockngdmbdbkfehdpfcfa",
    "CACHE_TTL_SECONDS": "300"
  },
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "43001", "simple": { "limit": 30, "period": 60 } },
    { "name": "TOKEN_LIMITER", "namespace_id": "43002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
